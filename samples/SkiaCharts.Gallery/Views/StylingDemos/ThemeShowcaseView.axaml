<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SkiaCharts.Gallery.ViewModels.StylingDemos"
             xmlns:controls="using:SkiaCharts.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SkiaCharts.Gallery.Views.StylingDemos.ThemeShowcaseView"
             x:DataType="vm:ThemeShowcaseViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="20,16" Margin="0,0,0,16">
            <StackPanel Spacing="8">
                <TextBlock Text="Theme Showcase"
                           FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Compare all built-in themes side by side. Select a theme to see the chart update."
                           FontSize="14" Opacity="0.7"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Theme Selector -->
        <Border Grid.Row="1" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="20" Margin="20,0,20,16">
            <StackPanel Spacing="12">
                <TextBlock Text="Select Theme:" FontWeight="SemiBold" />
                <ComboBox ItemsSource="{Binding Themes}"
                          SelectedItem="{Binding SelectedTheme}"
                          HorizontalAlignment="Stretch"
                          MinWidth="200">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </StackPanel>
        </Border>

        <!-- Chart -->
        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="8" Padding="20" Margin="20">
            <controls:SkiaChartView Chart="{Binding Chart}" />
        </Border>
    </Grid>

</UserControl>
