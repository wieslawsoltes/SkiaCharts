<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SkiaCharts.Gallery.ViewModels.RealTimeDemos"
             xmlns:controls="using:SkiaCharts.Avalonia.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SkiaCharts.Gallery.Views.RealTimeDemos.LiveTickerView"
             x:DataType="vm:LiveTickerViewModel">

    <Grid RowDefinitions="Auto,Auto,*">
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="20,16" Margin="0,0,0,16">
            <StackPanel Spacing="8">
                <TextBlock Text="Live Data Ticker"
                           FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="Real-time price ticker displaying live updates every 500ms. Shows current price with direction indicator and change amount, maintaining a 50-point history."
                           FontSize="14" Opacity="0.7"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{DynamicResource SystemAccentColor}"
                Padding="16,12" Margin="20,0,20,16" CornerRadius="6">
            <TextBlock Text="{Binding Status}"
                       FontSize="20" FontWeight="Bold"
                       Foreground="White"
                       HorizontalAlignment="Center" />
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                CornerRadius="8" Padding="20" Margin="20">
            <controls:SkiaChartView Chart="{Binding Chart}" />
        </Border>
    </Grid>

</UserControl>
