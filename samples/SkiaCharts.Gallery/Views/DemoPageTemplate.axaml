<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="SkiaCharts.Gallery.Views.DemoPageTemplate"
             x:CompileBindings="False">

    <Grid RowDefinitions="Auto,*">
        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource SystemControlBackgroundAltHighBrush}"
                Padding="20,16" Margin="0,0,0,16">
            <StackPanel Spacing="8">
                <TextBlock Text="{Binding Title}"
                           FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Description}"
                           FontSize="14" Opacity="0.7"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <StackPanel Spacing="16" Margin="20">
                <!-- Demo content goes here -->
                <ContentControl Content="{Binding Content}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>

</UserControl>
